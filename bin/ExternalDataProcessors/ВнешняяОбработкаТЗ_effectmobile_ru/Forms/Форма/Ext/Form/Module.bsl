// Заполняет таблицу ведомостей
Процедура ЗаполнитьНужноеНаСервере(ДатаОтправки, ОператорСравнения, ХарактеристикаДатыСравнения)
//
// 1. Получаем данные из запроса
// 2. Проверяем условия
// 3. Заполняем таблицу ведомостей
//
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ИсторияСтатусовДокументов.ДатаЗаписи) КАК ДатаЗаписи,
	|	ИсторияСтатусовДокументов.Документ
	|ПОМЕСТИТЬ МаксДатаСтатусаДокумента
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовДокументов КАК ИсторияСтатусовДокументов
	|СГРУППИРОВАТЬ ПО
	|	ИсторияСтатусовДокументов.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияСтатусовДокументов.Документ КАК Документ,
	|	ИсторияСтатусовДокументов.Статус КАК АктуальныйСтатусДокумента
	|ПОМЕСТИТЬ АктуальныеСтатусыДокументовВТ
	|ИЗ
	|	МаксДатаСтатусаДокумента КАК МаксДатаСтатусаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовДокументов КАК ИсторияСтатусовДокументов
	|		ПО МаксДатаСтатусаДокумента.Документ = ИсторияСтатусовДокументов.Документ
	|		И МаксДатаСтатусаДокумента.ДатаЗаписи = ИсторияСтатусовДокументов.ДатаЗаписи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ведомость.Ссылка КАК Ведомость,
	|	Ведомость.Номер КАК НомерВедомости,
	|	Ведомость.Дата КАК ДатаВедомости,
	|	АктуальныеСтатусыДокументовВТ.АктуальныйСтатусДокумента КАК СтатусВедомости,
	|	Ведомость.Договоры.(
	|		НомерСтроки КАК НомерСтрокиТЧВедомости,
	|		Договор.Наименование КАК НаименованиеДоговора,
	|		Договор.НачалоДействия КАК НачалоДействияДоговора,
	|		Договор.Активен КАК ДоговорАктивен) КАК Договоры
	|ИЗ
	|	Документ.Ведомость КАК Ведомость
	|		ЛЕВОЕ СОЕДИНЕНИЕ АктуальныеСтатусыДокументовВТ КАК АктуальныеСтатусыДокументовВТ
	|		ПО АктуальныеСтатусыДокументовВТ.Документ = Ведомость.Ссылка
	|ГДЕ
	|	НЕ Ведомость.ПометкаУдаления";

	РезультатЗапроса 	= Запрос.Выполнить();
	ВыборкаДокументов 	= РезультатЗапроса.Выбрать();

//// Проверяем наличие реквизита в форме.
//	РеквизитыФормы = ПолучитьРеквизиты();
//	ИмяРеквизита = "РеквизитТаблицаНужныеВедомости";
//	РеквизитНайден = Ложь;
//
//	Для Каждого Реквизит Из РеквизитыФормы Цикл
//		Если Реквизит.Имя = ИмяРеквизита Тогда
//			РеквизитНайден = Истина;
//			Прервать;
//		КонецЕсли;
//	КонецЦикла;
//
//	Если Не РеквизитНайден Тогда
//		СоздатьТабличнуюЧастьНаФорме();
//	КонецЕсли;
	
// Получаем таблицу через РеквизитФормыВЗначение.
	ТаблицаНужныеВедомости = Объект.ТаблицаНужныеВедомости;
	ТаблицаНужныеВедомости.Очистить();
	
//Поместить данные из запроса в табличную часть формы с проверкой условий по датам.
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ПроверитьДокументы = ПроверитьДоговорыВДокументе(ВыборкаДокументов, ОператорСравнения,
			ХарактеристикаДатыСравнения, ДатаОтправки);

		Если ПроверитьДокументы Тогда
			НоваяСтрока 				= ТаблицаНужныеВедомости.Добавить();
			НоваяСтрока.Ведомость 		= ВыборкаДокументов.Ведомость;
			НоваяСтрока.ДатаВедомости 	= ВыборкаДокументов.ДатаВедомости;
			НоваяСтрока.СтатусВедомости = ВыборкаДокументов.СтатусВедомости;	
		КонецЕсли;

	КонецЦикла;
	
	ТаблицаНужныеВедомости.Сортировать("ДатаВедомости Возр"); // сортировка таблицы ведомостей по дате
	
//	ЗначениеВРеквизитФормы(ТаблицаНужныеВедомости, "РеквизитТаблицаНужныеВедомости");
	Элементы.ТаблицаНужныеВедомости.Видимость = Истина;
	УстановитьЦветСтрокиТаблицы();			
КонецПроцедуры

